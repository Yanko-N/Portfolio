<MudDialog>
    <DialogContent>
        <MudImage Src="@ImageSource"
                  Alt="@AltText"
                  Style="display:block; max-width:100%; max-height:80vh; object-fit:contain; margin:auto;" />
    </DialogContent>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string ImageSource { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string AltText { get; set; } = string.Empty;
}
