@using Application.Classes
@using Application.Interfaces.Services
@using Portfolio.Components
@using static Application.Contracts.DTOs.Response

@attribute [Route(ApplicationConstants.Routes.EducationDetail)]
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IEducationService EducationService
@inject IJSRuntime JS

@if (IsLoading)
{
    <div class="d-flex align-items-center justify-content-center min-vh-100">
        <div class="text-center">
            <div class="spinner-border mb-3" role="status" aria-hidden="true"></div>
            <p class="mb-0 text-muted">Loading educations information…</p>
        </div>
    </div>
}
else if (dto != null)
{
    <div class="container-xl my-4 education-details">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack">
                Back to education
            </MudButton>
        </div>
        <section class="education-hero mb-4">
            <div class="education-hero-mark"><MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" /></div>
            <div class="education-hero-copy">
                <span class="education-eyebrow">Education</span>
                <h1>@dto.Course?.Name</h1>
                <p>@dto.School?.Name @if (!string.IsNullOrWhiteSpace(dto.School?.Location)) { <span aria-hidden="true">·</span> @dto.School.Location }</p>
                <span class="education-period">@FormatPeriod(dto.StartDate, dto.EndDate)</span>
            </div>
            @if (dto.EndDate == null)
            {
                <MudChip Color="Color.Success" Variant="Variant.Filled" T="string" Class="education-current">In progress</MudChip>
            }
            @if (!string.IsNullOrWhiteSpace(dto.Course?.Url))
            {
                <MudButton Class="education-course-link"
                           Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           Href="@dto.Course.Url"
                           Target="_blank"
                           Rel="noopener"
                           EndIcon="@Icons.Material.Filled.OpenInNew">
                    Course page
                </MudButton>
            }
        </section>
        <div class="row justify-content-center">
            <div class="col-12">
                <MudPaper Elevation="2" Class="p-4 p-md-5 rounded-4">
                    <div class="mb-3">
                        <h2 class="mb-1 fw-bold">Program overview</h2>
                        <p class="text-muted mb-0">@FormatDates(dto.StartDate, dto.EndDate)</p>
                    </div>

                    <MudDivider Class="my-4" />

                    <div class="description-text mb-4 lh-lg">
                        @(!string.IsNullOrWhiteSpace(dto.Course?.Description)
                            ? dto.Course.Description
                            : "No description available.")
                    </div>

                    @if (dto.Skills?.Count > 0)
                    {
                        <MudDivider Class="my-4" />
                        <h3 class="text-uppercase text-muted mb-3 fw-semibold">Skills & Technologies</h3>

                        @foreach (var group in GroupedSkills())
                        {
                            <div class="mb-4">
                                <div class="fw-semibold mb-3 text-secondary">@group.Key</div>

                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var skill in group)
                                    {
                                        <MudTooltip Placement="Placement.Top" Style="max-width:none" Class="skill-tooltip">
                                            <ChildContent>
                                                <div class="skill-chip" tabindex="0" role="img" aria-label="@skill.Name">
                                                    @if (!string.IsNullOrWhiteSpace(skill.Icon))
                                                    {
                                                        <MudIcon Icon="@skill.Icon" Size="Size.Medium" Color="Color.Inherit" Class="opacity-75" />
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.caption" Class="opacity-75 fw-bold text-uppercase">
                                                            @skill.Name
                                                        </MudText>
                                                    }
                                                </div>
                                            </ChildContent>
                                            <TooltipContent>
                                                <div class="skill-tooltip-body">
                                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@skill.Name</MudText>
                                                    <MudText Typo="Typo.caption">@skill.Description</MudText>
                                                </div>
                                            </TooltipContent>
                                        </MudTooltip>
                                    }
                                </div>
                            </div>
                        }
                    }
                </MudPaper>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-md my-4">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @Error
                </MudAlert>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    public bool IsLoading { get; set; } = true;
    public EducationDto? dto { get; set; }
    public string? Error { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    protected async Task LoadAsync()
    {
        try
        {
            IsLoading = true;

            if (Id == null || Id <= 0)
            {
                Error = "Invalid education ID.";
                return;
            }

            var result = await EducationService.GetEducationAsync((int)Id);

            if (result.IsSuccess)
            {
                dto = result.Value;
                return;
            }

            Error = result.ErrorMessage ?? "Failed to load education details.";
            Snackbar.Add(Error, Severity.Error, cfg =>
            {
                cfg.RequireInteraction = false;
                cfg.ShowCloseIcon = true;
            });
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error, cfg =>
            {
                cfg.RequireInteraction = false;
                cfg.ShowCloseIcon = true;
            });
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task GoBack()
    {
        try
        {
            var canGoBack = await JS.InvokeAsync<bool>("appNav.canGoBack");
            if (canGoBack)
            {
                await JS.InvokeVoidAsync("appNav.goBack");
                return;
            }
        }
        catch
        {
        }

        NavigationManager.NavigateTo(ApplicationConstants.Routes.Index);
    }

    private static string FormatDates(DateOnly start, DateOnly? end)
        => $"{start:MMMM yyyy} – {(end == null ? "Current" : end.Value.ToString("MMMM yyyy"))}";

    private static string FormatPeriod(DateOnly start, DateOnly? end)
    {
        var realEnd = end ?? DateOnly.FromDateTime(DateTime.Today);
        var (years, months) = DiffInYearsMonths(start, realEnd);

        string dur =
            years > 0 && months > 0 ? $"{years} year{(years > 1 ? "s" : "")} and {months} month{(months > 1 ? "s" : "")}" :
            years > 0 ? $"{years} year{(years > 1 ? "s" : "")}" :
            $"{months} month{(months == 1 ? "" : "s")}";

        return $"{start:MMM yyyy} – {(end == null ? "Current" : realEnd.ToString("MMM yyyy"))} · {dur}";
    }

    private static (int years, int months) DiffInYearsMonths(DateOnly start, DateOnly end)
    {
        var totalMonths = (end.Year - start.Year) * 12 + (end.Month - start.Month);
        if (end.Day < start.Day) totalMonths -= 1;
        if (totalMonths < 0) totalMonths = 0;

        var years = totalMonths / 12;
        var months = totalMonths % 12;
        return (years, months);
    }

    private IEnumerable<IGrouping<string, SkillDto>> GroupedSkills()
        => (dto?.Skills ?? Array.Empty<SkillDto>())
            .GroupBy(s => string.IsNullOrWhiteSpace(s.Category) ? "Others" : s.Category)
            .OrderBy(g => g.Key);
}

<style>
    .education-details {
        max-width: 1240px;
    }

    .education-hero {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: clamp(1.5rem, 4vw, 3rem);
        border-radius: 24px;
        color: white;
        background: radial-gradient(circle at 85% 15%, rgba(34, 211, 238, .35), transparent 28%), linear-gradient(120deg, #102a43, #0f766e 68%, #2563eb);
        box-shadow: 0 16px 38px rgba(15, 118, 110, .18);
    }

    .education-hero-mark {
        display: grid;
        flex: 0 0 auto;
        width: 72px;
        height: 72px;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, .4);
        border-radius: 22px;
        background: rgba(255, 255, 255, .14);
        color: white;
        backdrop-filter: blur(8px);
    }

    .education-hero-copy {
        flex: 1;
        min-width: 0;
    }

    .education-eyebrow {
        color: rgba(255, 255, 255, .75);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .education-hero h1 {
        margin: .35rem 0;
        font-size: clamp(1.6rem, 4vw, 2.5rem);
        font-weight: 800;
    }

    .education-hero p {
        margin: 0 0 .5rem;
        color: rgba(255, 255, 255, .85);
    }

    .education-period {
        color: rgba(255, 255, 255, .72);
        font-size: .9rem;
    }

    .education-course-link {
        border-color: rgba(255, 255, 255, .55);
        color: white;
    }

    .description-text {
        white-space: pre-line;
        line-height: 1.75;
    }

    @@media (max-width: 640px) {
        .education-hero {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .education-hero-mark {
            width: 54px;
            height: 54px;
            border-radius: 16px;
        }

        .education-current,
        .education-course-link {
            margin-left: 4.3rem;
        }
    }
</style>