@using Application.Classes
@using Application.Interfaces.Services
@using Portfolio.Components
@using static Application.Contracts.DTOs.Response

@attribute [Route(ApplicationConstants.Routes.ProjectsDetail)]
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IProjectService ProjectService
@inject IJSRuntime JS
@inject IDialogService DialogService

@if (IsLoading)
{
    <div class="d-flex align-items-center Justify-content-center min-vh-100">
        <div class="text-center">
            <div class="spinner-border mb-3" role="status" aria-hidden="true"></div>
            <p class="mb-0 text-muted">Loading project information…</p>
        </div>
    </div>
}
else if (dto != null)
{
    <div class="container-xl my-4 project-details">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack">
                Back to projects
            </MudButton>
        </div>
        <section class="project-hero mb-4">
            @if (GetImageSource(dto.Images?.FirstOrDefault()) is { } coverSource)
            {
                <button type="button"
                        class="project-hero-image-button"
                        aria-label="View project cover image"
                        @onclick="() => OpenImagePreviewAsync(coverSource, dto.Images?.FirstOrDefault()?.AltText)">
                    <img src="@coverSource" alt="@dto.Images?.FirstOrDefault()?.AltText" class="project-hero-image" />
                </button>
            }
            <div class="project-hero-shade"></div>
            <div class="project-hero-content">
                @if (!string.IsNullOrWhiteSpace(dto.Category))
                {
                    <MudChip Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" T="string">@dto.Category</MudChip>
                }
                <h1>@dto.Name</h1>
                <p>@(dto.Images?.Count ?? 0) project screenshot@((dto.Images?.Count ?? 0) == 1 ? "" : "s")</p>
                @if (!string.IsNullOrWhiteSpace(dto.DemoUrl) || !string.IsNullOrWhiteSpace(dto.SourceCodeUrl))
                {
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @if (!string.IsNullOrWhiteSpace(dto.DemoUrl))
                        {
                            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.PlayCircle"
                                       OnClick="@(()=>OpenExternal(dto.DemoUrl!))">
                                Live demo
                            </MudButton>
                        }
                        @if (!string.IsNullOrWhiteSpace(dto.SourceCodeUrl))
                        {
                            <MudButton Color="Color.Inherit" Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Code"
                                       OnClick="@(()=>OpenExternal(dto.SourceCodeUrl!))">
                                Source code
                            </MudButton>
                        }
                    </div>
                }
            </div>
        </section>
        <div class="row justify-content-center">
            <div class="col-12">
                <MudPaper Elevation="2" Class="p-4 p-md-5 rounded-4">
                    <div class="mb-3">
                        <h2 class="mb-2 fw-bold">About this project</h2>
                    </div>

                    <MudDivider Class="mb-3" />

                    <div class="description-text mb-4 lh-lg">
                        @(!string.IsNullOrWhiteSpace(dto.Description) ? dto.Description : "No description available.")
                    </div>

                            @if (dto.Skills?.Count > 0)
                            {
                                <MudDivider Class="mb-4" />
                                <h6 class="text-uppercase text-muted mb-3 fw-semibold">Skills & Technologies</h6>

                                @foreach (var group in GroupedSkills())
                                {
                                    <div class="mb-3">
                                        <div class="fw-semibold mb-2 text-secondary">@group.Key</div>

                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var skill in group)
                                            {
                                                <MudTooltip Placement="Placement.Top" Style="max-width:none" Class="skill-tooltip">
                                                    <ChildContent>
                                                        <div class="skill-chip" tabindex="0" role="img" aria-label="@skill.Name">
                                                            @if (!string.IsNullOrWhiteSpace(skill.Icon))
                                                            {
                                                                <MudIcon Icon="@skill.Icon" Size="Size.Medium" Color="Color.Inherit" Class="opacity-75" />
                                                            }
                                                            else
                                                            {
                                                                <MudText Typo="Typo.caption" Class="opacity-75 fw-bold text-uppercase">
                                                                    @skill.Name
                                                                </MudText>
                                                            }
                                                        </div>
                                                    </ChildContent>
                                                    <TooltipContent>
                                                        <div class="skill-tooltip-body">
                                                            <MudText Typo="Typo.subtitle2" Class="fw-bold">@skill.Name</MudText>
                                                            <MudText Typo="Typo.caption">@skill.Description</MudText>
                                                        </div>
                                                    </TooltipContent>
                                                </MudTooltip>
                                            }
                                        </div>
                                    </div>
                                }
                            }

                            @if (dto.Images?.Count > 0)
                            {
                                <MudDivider Class="my-4" />
                                <div class="d-flex align-items-end justify-content-between mb-3">
                                    <div>
                                        <h4 class="fw-bold mb-1">Project gallery</h4>
                                        <p class="text-muted mb-0">Screenshots and visuals from the project.</p>
                                    </div>
                                    <span class="text-muted small">@dto.Images.Count image@(dto.Images.Count == 1 ? "" : "s")</span>
                                </div>
                                <div class="row g-3">
                                    @foreach (var img in dto.Images)
                                    {
                                        <div class="col-12 @(dto.Images.Count > 1 ? "col-md-6" : "col-md-8")">
                                            @if (GetImageSource(img) is { } imageSource)
                                            {
                                                <button type="button"
                                                        class="gallery-link"
                                                        aria-label="View image: @img.AltText"
                                                        @onclick="() => OpenImagePreviewAsync(imageSource, img.AltText)">
                                                    <img src="@imageSource" alt="@img.AltText" class="gallery-img rounded-3 shadow-sm w-100" />
                                                    <span class="gallery-caption">@img.AltText</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="ratio ratio-16x9 rounded-3 bg-light d-flex align-items-center justify-content-center border">
                                                    <span class="text-muted small px-2 text-center">@img.AltText</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                </MudPaper>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-md my-4">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @Error
                </MudAlert>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    public bool IsLoading { get; set; } = true;
    public ProjectDto? dto { get; set; }
    public string? Error { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    protected async Task LoadAsync()
    {
        try
        {
            IsLoading = true;

            if (Id == null || Id <= 0)
            {
                Error = "Invalid project ID.";
                return;
            }

            var result = await ProjectService.GetProjectAsync((int)Id);

            if (result.IsSuccess)
            {
                dto = result.Value;
                return;
            }

            Error = result.ErrorMessage ?? "Failed to load project details.";
            Snackbar.Add(Error, Severity.Error, cfg =>
            {
                cfg.RequireInteraction = false;
                cfg.ShowCloseIcon = true;
            });
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error, cfg =>
            {
                cfg.RequireInteraction = false;
                cfg.ShowCloseIcon = true;
            });
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string BuildUrl(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return string.Empty;

        if (Uri.TryCreate(s, UriKind.Absolute, out var abs)) return abs.ToString();

        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        var rel = s.TrimStart('/');
        return $"{baseUri}/{rel}";
    }

    private string GetAlt(ProjectDto p) => p.Images?.FirstOrDefault()?.AltText ?? $"{p.Name} cover";


    private string Placeholder()
        => $"{NavigationManager.BaseUri.TrimEnd('/')}/images/placeholders/project-thumb.svg";

    private string GetCover(ProjectDto p)
    {
        var img = p.Images?.FirstOrDefault(i =>
            !string.IsNullOrWhiteSpace(i.Url) || !string.IsNullOrWhiteSpace(i.Path));

        var url = BuildUrl(img?.Url);
        if (!string.IsNullOrWhiteSpace(url)) return url;

        var path = BuildUrl(img?.Path);
        return !string.IsNullOrWhiteSpace(path) ? path : Placeholder();
    }

    private string GetImage(ImageDto img)
    {
        var url = BuildUrl(img?.Url);
        if (!string.IsNullOrWhiteSpace(url)) return url;

        var path = BuildUrl(img?.Path);
        return !string.IsNullOrWhiteSpace(path) ? path : Placeholder();
    }

    private async Task GoBack()
    {
        try
        {
            var canGoBack = await JS.InvokeAsync<bool>("appNav.canGoBack");
            if (canGoBack)
            {
                await JS.InvokeVoidAsync("appNav.goBack");
                return;
            }
        }
        catch
        {
        }

        NavigationManager.NavigateTo(ApplicationConstants.Routes.Index);
    }

    private void OpenExternal(string url)
        => NavigationManager.NavigateTo(url, forceLoad: true);

    private async Task OpenImagePreviewAsync(string imageSource, string? altText)
    {
        var parameters = new DialogParameters<ImagePreviewDialog>
        {
            { dialog => dialog.ImageSource, imageSource },
            { dialog => dialog.AltText, altText ?? "Project image" }
        };

        await DialogService.ShowAsync<ImagePreviewDialog>(
            altText ?? "Project image",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            });
    }

    private string? GetImageSource(ImageDto? image)
    {
        if (image == null)
        {
            return null;
        }

        var source = !string.IsNullOrWhiteSpace(image.Url) ? image.Url : image.Path;
        if (string.IsNullOrWhiteSpace(source))
        {
            return null;
        }

        if (Uri.TryCreate(source, UriKind.Absolute, out var absoluteUri))
        {
            return absoluteUri.ToString();
        }

        return $"{NavigationManager.BaseUri.TrimEnd('/')}/{source.TrimStart('/')}";
    }

    private IEnumerable<IGrouping<string, SkillDto>> GroupedSkills()
        => (dto?.Skills ?? Array.Empty<SkillDto>())
            .GroupBy(s => string.IsNullOrWhiteSpace(s.Category) ? "Others" : s.Category)
            .OrderBy(g => g.Key);
}

<style>
    .project-details {
        max-width: 1240px;
    }

    .project-hero {
        position: relative;
        min-height: 300px;
        overflow: hidden;
        border-radius: 24px;
        background: linear-gradient(135deg, #111827, #334155);
        box-shadow: 0 16px 38px rgba(15, 23, 42, .18);
    }

    .project-hero-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
    }

    .project-hero-image-button {
        position: absolute;
        inset: 0;
        width: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: zoom-in;
    }

    .project-hero-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(15, 23, 42, .92), rgba(15, 23, 42, .52) 54%, rgba(15, 23, 42, .12));
        pointer-events: none;
    }

    .project-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        min-height: 300px;
        max-width: 720px;
        padding: clamp(1.5rem, 5vw, 3.5rem);
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-start;
        color: #fff;
    }

    .project-hero-content h1 {
        margin: 1rem 0 .5rem;
        font-size: clamp(2rem, 5vw, 3.25rem);
        font-weight: 800;
        line-height: 1.05;
    }

    .project-hero-content p {
        margin: 0;
        color: rgba(255, 255, 255, .8);
    }

    .description-text {
        white-space: pre-line;
        line-height: 1.6;
    }

    .gallery-link {
        position: relative;
        display: block;
        width: 100%;
        padding: 0;
        border: 0;
        overflow: hidden;
        border-radius: 14px;
        background: #f1f5f9;
        text-align: left;
        cursor: zoom-in;
    }

    .gallery-img {
        aspect-ratio: 16 / 9;
        object-fit: contain;
        display: block;
        transition: transform .35s ease;
    }

    .gallery-link:hover .gallery-img {
        transform: scale(1.025);
    }

    .gallery-caption {
        display: block;
        padding: .65rem .8rem;
        color: var(--mud-palette-text-secondary);
        font-size: .85rem;
    }

    @@media (max-width: 991.98px) {
        .project-hero,
        .project-hero-content {
            min-height: 230px;
        }
    }
</style>