@using Application.Classes
@using Application.Interfaces.Services
@using Portfolio.Components
@using static Application.Contracts.DTOs.Response

@attribute [Route(ApplicationConstants.Routes.WorkDetail)]
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IWorkService WorkService
@inject IJSRuntime JS
@inject IDialogService DialogService


@if (IsLoading)
{
    <div class="d-flex align-items-center justify-content-center min-vh-100">
        <div class="text-center">
            <div class="spinner-border mb-3" role="status" aria-hidden="true"></div>
            <p class="mb-0 text-muted">Loading work experience information…</p>
        </div>
    </div>
}
else if (dto != null)
{
    <div class="container-xl my-4 work-details">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack">
                Back to experience
            </MudButton>
        </div>
        <section class="work-hero mb-4">
            @if (GetImageSource(dto.Enterprise?.Image) is { } companyImage)
            {
                <button type="button"
                        class="work-hero-logo work-hero-logo-button"
                        aria-label="View @dto.Enterprise?.Name image"
                        @onclick="() => OpenImagePreviewAsync(companyImage, dto.Enterprise?.Image?.AltText)">
                    <img src="@companyImage" alt="@dto.Enterprise?.Image?.AltText" />
                </button>
            }
            else
            {
                <div class="work-hero-mark">@GetCompanyMark()</div>
            }
            <div class="work-hero-copy">
                <span class="work-eyebrow">Career experience</span>
                <h1>@dto.Title</h1>
                <p>@dto.Enterprise?.Name <span aria-hidden="true">·</span> @FormatDates(dto.StartDate, dto.EndDate)</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(dto.Enterprise?.Url))
            {
                <MudButton Class="work-company-link"
                           Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           Href="@dto.Enterprise.Url"
                           Target="_blank"
                           Rel="noopener"
                           EndIcon="@Icons.Material.Filled.OpenInNew">
                    Company
                </MudButton>
            }
            @if (dto.EndDate == null)
            {
                <MudChip Color="Color.Success" Variant="Variant.Filled" T="string" Class="work-current">Current role</MudChip>
            }
        </section>
        <div class="row justify-content-center">
            <div class="col-12">
                <MudPaper Elevation="2" Class="p-4 p-md-5 rounded-4">
                            <div class="mb-4">
                                <h2 class="mb-2 fw-bold">Role overview</h2>
                                <p class="text-muted mb-0">
                                    @FormatPeriod(dto.StartDate, dto.EndDate)
                                </p>
                            </div>

                            <MudDivider Class="mb-4" />

                            <div class="work-highlights">
                                @foreach (var highlight in GetHighlights())
                                {
                            <article class="work-highlight">
                                <span class="work-highlight-icon"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /></span>
                                <p>@highlight</p>
                            </article>
                                }
                            </div>

                            @if (dto.Skills?.Count > 0)
                            {
                                <MudDivider Class="mb-4" />
                                <h6 class="text-uppercase text-muted mb-3 fw-semibold">Skills & Technologies</h6>

                                @foreach (var group in GroupedSkills())
                                {
                                    <div class="mb-4">
                                        <div class="fw-semibold mb-3 text-secondary">
                                            @group.Key
                                        </div>

                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var skill in group)
                                            {
                                                <MudTooltip Placement="Placement.Top"
                                                            Style="max-width:none"
                                                            Class="skill-tooltip">
                                                    <ChildContent>
                                                        <div class="skill-chip" tabindex="0" role="img" aria-label="@skill.Name">
                                                            @if (!string.IsNullOrWhiteSpace(skill.Icon))
                                                            {
                                                                <MudIcon Icon="@skill.Icon" Size="Size.Medium" Color="Color.Inherit" Class="opacity-75" />
                                                            }
                                                            else
                                                            {
                                                                <MudText Typo="Typo.caption" Class="opacity-75 fw-bold text-uppercase">
                                                                    @skill.Name
                                                                </MudText>
                                                            }
                                                        </div>
                                                    </ChildContent>

                                                    <TooltipContent>
                                                        <div class="skill-tooltip-body">
                                                            <MudText Typo="Typo.subtitle2" Class="fw-bold">@skill.Name</MudText>
                                                            <MudText Typo="Typo.caption">@skill.Description</MudText>
                                                        </div>
                                                    </TooltipContent>
                                                </MudTooltip>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                </MudPaper>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-md my-4">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @Error
                </MudAlert>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public int? Id { get; set; }


    public bool IsLoading { get; set; } = true;

    public WorkDto? dto { get; set; }
    public string? Error { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    protected async Task LoadAsync()
    {
        try
        {
            IsLoading = true;

            if (Id == null || Id <= 0)
            {
                Error = "Invalid work experience ID.";
                return;
            }

            var result = await WorkService.GetWorkAsync((int)Id);

            if (result.IsSuccess)
            {
                dto = result.Value;
                return;
            }

            Error = result.ErrorMessage ?? "Failed to load work experience details.";

            Snackbar.Add(Error, Severity.Error, cfg =>
            {
                cfg.RequireInteraction = false;
                cfg.ShowCloseIcon = true;
            });

        }
        catch (Exception ex)
        {
            Error = ex.Message;
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error, cfg =>
            {
                cfg.RequireInteraction = false;
                cfg.ShowCloseIcon = true;
            });
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task GoBack()
    {
        try
        {
            var canGoBack = await JS.InvokeAsync<bool>("appNav.canGoBack");
            if (canGoBack)
            {
                await JS.InvokeVoidAsync("appNav.goBack");
                return;
            }
        }
        catch
        {
            //ignore
        }

        NavigationManager.NavigateTo(ApplicationConstants.Routes.Index);
    }

    private static string FormatDates(DateOnly start, DateOnly? end)
      => $"{start:MMMM yyyy} – {(end == null ? "Current" : end.Value.ToString("MMMM yyyy"))}";

    private static string FormatPeriod(DateOnly start, DateOnly? end)
    {
        var realEnd = end ?? DateOnly.FromDateTime(DateTime.Today);
        var (years, months) = DiffInYearsMonths(start, realEnd);

        string dur =
            years > 0 && months > 0 ? $"{years} year{(years > 1 ? "s" : "")} and {months} month{(months > 1 ? "s" : "")}" :
            years > 0 ? $"{years} year{(years > 1 ? "s" : "")}" :
            $"{months} month{(months == 1 ? "" : "s")}";

        return $"{start:MMM yyyy} – {(end == null ? "Current" : realEnd.ToString("MMM yyyy"))} · {dur}";
    }

    private static (int years, int months) DiffInYearsMonths(DateOnly start, DateOnly end)
    {
        var totalMonths = (end.Year - start.Year) * 12 + (end.Month - start.Month);
        if (end.Day < start.Day) totalMonths -= 1;
        if (totalMonths < 0) totalMonths = 0;

        var years = totalMonths / 12;
        var months = totalMonths % 12;
        return (years, months);
    }

    private IEnumerable<IGrouping<string, SkillDto>> GroupedSkills()
        => (dto?.Skills ?? Array.Empty<SkillDto>())
            .GroupBy(s => string.IsNullOrWhiteSpace(s.Category) ? "Others" : s.Category)
            .OrderBy(g => g.Key);

    private IEnumerable<string> GetHighlights()
    {
        if (string.IsNullOrWhiteSpace(dto?.Description))
        {
            return new[] { "No description available." };
        }

        var highlights = dto.Description
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return highlights.Length > 1 ? highlights : new[] { dto.Description };
    }

    private string GetCompanyMark()
        => string.IsNullOrWhiteSpace(dto?.Enterprise?.Name)
            ? "•"
            : dto.Enterprise.Name[..Math.Min(1, dto.Enterprise.Name.Length)].ToUpperInvariant();

    private string? GetImageSource(ImageDto? image)
    {
        if (image == null)
        {
            return null;
        }

        var source = !string.IsNullOrWhiteSpace(image.Url) ? image.Url : image.Path;
        if (string.IsNullOrWhiteSpace(source))
        {
            return null;
        }

        if (Uri.TryCreate(source, UriKind.Absolute, out var absoluteUri))
        {
            return absoluteUri.ToString();
        }

        return $"{NavigationManager.BaseUri.TrimEnd('/')}/{source.TrimStart('/')}";
    }

    private async Task OpenImagePreviewAsync(string imageSource, string? altText)
    {
        var parameters = new DialogParameters<ImagePreviewDialog>
        {
            { dialog => dialog.ImageSource, imageSource },
            { dialog => dialog.AltText, altText ?? "Company image" }
        };

        await DialogService.ShowAsync<ImagePreviewDialog>(
            altText ?? "Company image",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            });
    }

}

<style>
    .work-details {
        max-width: 1240px;
    }

    .work-hero {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: clamp(1.5rem, 4vw, 3rem);
        border-radius: 24px;
        color: white;
        background: radial-gradient(circle at 85% 15%, rgba(96, 165, 250, .48), transparent 28%), linear-gradient(120deg, #101b35, #1d4ed8 68%, #6d28d9);
        box-shadow: 0 16px 38px rgba(30, 64, 175, .18);
    }

    .work-hero-mark,
    .work-hero-logo {
        display: grid;
        flex: 0 0 auto;
        width: 72px;
        height: 72px;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, .4);
        border-radius: 22px;
        background: rgba(255, 255, 255, .14);
        color: white;
        font-size: 2rem;
        font-weight: 800;
        backdrop-filter: blur(8px);
    }

    .work-hero-logo-button {
        padding: 0;
        cursor: zoom-in;
    }

    .work-hero-logo {
        padding: .65rem;
        border: 0;
        border-radius: 18px;
        background: white;
    }

    .work-hero-logo img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .work-hero-copy {
        flex: 1;
    }

    .work-eyebrow {
        color: rgba(255, 255, 255, .75);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .work-hero h1 {
        margin: .35rem 0;
        font-size: clamp(1.6rem, 4vw, 2.5rem);
        font-weight: 800;
    }

    .work-hero p {
        margin: 0;
        color: rgba(255, 255, 255, .82);
    }

    .work-company-link {
        border-color: rgba(255, 255, 255, .55);
        color: white;
    }

    .work-highlight {
        display: flex;
        gap: .85rem;
        align-items: flex-start;
        padding: 1rem;
        border: 1px solid rgba(100, 116, 139, .16);
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(248, 250, 252, .9), rgba(239, 246, 255, .78));
    }

    .work-highlight + .work-highlight {
        margin-top: .8rem;
    }

    .work-highlight-icon {
        display: grid;
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        place-items: center;
        border-radius: 9px;
        background: #dbeafe;
        color: #1d4ed8;
    }

    .work-highlight p {
        margin: .1rem 0 0;
        line-height: 1.7;
    }

    @@media (max-width: 640px) {
        .work-hero {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .work-hero-logo {
            width: 54px;
            height: 54px;
            border-radius: 14px;
        }

        .work-hero-mark {
            width: 54px;
            height: 54px;
            border-radius: 16px;
        }

        .work-current {
            margin-left: 4.3rem;
        }
    }
</style>